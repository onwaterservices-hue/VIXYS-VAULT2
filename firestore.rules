rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isBackend() {
      return isSignedIn() && request.auth.uid == 'LcNWvC9lC9XbvIuddsS2m6VJl3l2';
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_check/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isBackend();
      allow write: if isBackend() || (isOwner(userId) && isValidId(userId));

      match /journalEntries/{entryId} {
        allow read, write: if isOwner(userId) && isValidId(entryId);
      }
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn() || isBackend();
      allow create: if isSignedIn() && isValidId(ticketId);
      allow update, delete: if isSignedIn() || isBackend();
    }

    match /predictions/{predictionId} {
      allow read: if true;
      allow write: if isBackend() || (isSignedIn() && isValidId(predictionId));
    }

    match /signal_logs/{signalId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /telemetry_observations/{obsId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /day_passes/{docId} {
      allow read: if isBackend();
      allow write: if isBackend();
    }

    match /subscriptions/{subId} {
      allow read: if isBackend() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email));
      allow write: if isBackend();
    }

    match /webhook_events/{eventId} {
      allow read, write: if isBackend();
    }
    
    match /discordProfiles/{profileId} {
      allow read, write: if isBackend();
    }
    match /system_state/{stateId} {
      allow read, write: if isBackend();
    }
    match /calibration_state/{stateId} {
      allow read, write: if isBackend();
    }
    match /settlement_locks/{lockId} {
      allow read, write: if isBackend();
    }
    match /discord_profiles/{profileId} {
      allow read: if isSignedIn() || isBackend();
      allow write: if isBackend();
    }
  }
}
