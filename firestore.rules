rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_check/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;

      match /journalEntries/{entryId} {
        allow read, write: if true;
      }
    }

    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    match /predictions/{predictionId} {
      allow read, write: if true;
    }

    match /signal_logs/{signalId} {
      allow read, write: if true;
    }

    match /telemetry_observations/{obsId} {
      allow read, write: if true;
    }

    match /day_passes/{docId} {
      allow read, write: if true;
    }

    match /subscriptions/{subId} {
      allow read, write: if true;
    }

    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    match /discordProfiles/{profileId} {
      allow read, write: if true;
    }

    match /discord_profiles/{profileId} {
      allow read, write: if true;
    }

    match /system_state/{stateId} {
      allow read, write: if true;
    }

    match /calibration_state/{stateId} {
      allow read, write: if true;
    }

    match /settlement_locks/{lockId} {
      allow read, write: if true;
    }

    match /active_cycle_lock/{lockId} {
      allow read, write: if true;
    }

    match /decision_outcomes/{outcomeId} {
      allow read, write: if true;
    }

    match /regime_memory_bank/{memoryId} {
      allow read, write: if true;
    }

    match /algorithm_performance_history/{historyId} {
      allow read, write: if true;
    }
  }
}
