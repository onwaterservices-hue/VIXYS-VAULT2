# ==============================================================================
# VIXY AI — STREAMLINED CORE CONFIGURATION (.env)
# ==============================================================================
# Only the essential environment variables required for running and deploying VIXY AI.
# All other parameters have safe internal default values.

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT=3000

# ------------------------------------------------------------------------------
# 2. DISCORD INTEGRATION (Required for Discord Bot & Automation)
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=""               # Discord Bot Token (or DISCORD_TOKEN)
DISCORD_CLIENT_ID=""               # Discord OAuth / Bot Client ID
DISCORD_GUILD_ID=""                # Your Discord Server (Guild) ID

# Key Channel Targets (Optional — defaults to webhook fallback if empty)
DISCORD_CHANNEL_MARKET_ANALYSIS="" # Market Analysis Channel ID
DISCORD_CHANNEL_AI_SIGNALS=""       # Live Signals Channel ID
DISCORD_CHANNEL_BREAKING_NEWS=""    # Breaking News Channel ID
DISCORD_CHANNEL_AUDIT_LOGS=""       # Logs / Telemetry Channel ID

# Key Role IDs (Optional — defaults to mock/simulated role mapping if empty)
DISCORD_ROLE_VERIFIED=""           # Free / Verified Member Role ID
DISCORD_ROLE_ELITE=""              # VIP / Elite Member Role ID
DISCORD_ROLE_ADMINISTRATOR=""      # Admin Role ID

# Optional Primary Webhook Fallback
DISCORD_WEBHOOK_URL=""             # General Webhook URL for broadcasts

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENTS & VIP CHECKOUT (Optional)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY="pk_live_51TyidvCYsvFDvgUJoTUSzlu4HxZfVMq33TF3pXLnM4QisUgTwnGxDXmYN9631EIlMvzJaC5IYLTnLvlbmG9vYb1M00SkYFLSBF"
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_51TyidvCYsvFDvgUJoTUSzlu4HxZfVMq33TF3pXLnM4QisUgTwnGxDXmYN9631EIlMvzJaC5IYLTnLvlbmG9vYb1M00SkYFLSBF"
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 4. AI MODEL PROVIDERS (Optional — model fallback active if empty)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. SECURITY & PERSISTENCE
# ------------------------------------------------------------------------------
JWT_SECRET="vixy-ai-super-secret-jwt-key-32chars"
ENCRYPTION_KEY="vixy-ai-aes-256-encryption-key-passphrase"
