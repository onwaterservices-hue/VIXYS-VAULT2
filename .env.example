# ==============================================================================
# VIXY AI — STREAMLINED CORE CONFIGURATION (.env)
# ==============================================================================
# Only the essential environment variables required for running and deploying VIXY AI.
# All other parameters have safe internal default values.

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT=3000
ADMIN_EMAIL="vixyvault0@gmail.com"
ADMIN_USER_ID="vixyvault0@gmail.com"

# ------------------------------------------------------------------------------
# 2. DISCORD INTEGRATION (Required for Discord Bot & Automation)
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=""               # Discord Bot Token (or DISCORD_TOKEN)
DISCORD_CLIENT_ID=""               # Discord OAuth / Bot Client ID
DISCORD_CLIENT_SECRET=""           # Discord OAuth Client Secret
DISCORD_REDIRECT_URI=""            # Discord OAuth Redirect URI (e.g. https://www.vixxyvault.com/api/auth/discord/callback)
DISCORD_GUILD_ID=""                # Your Discord Server (Guild) ID

# Key Channel Targets (Optional — defaults to webhook fallback if empty)
DISCORD_CHANNEL_MARKET_ANALYSIS="" # Market Analysis Channel ID
DISCORD_CHANNEL_AI_SIGNALS=""       # Live Signals Channel ID
DISCORD_CHANNEL_BREAKING_NEWS=""    # Breaking News Channel ID
DISCORD_CHANNEL_AUDIT_LOGS=""       # Logs / Telemetry Channel ID

# Key Role IDs (Defaults to authoritative VIXY Vault Production Role IDs if empty)
DISCORD_ROLE_VERIFIED=""           # Free / Verified Base Role ID (e.g. 1454661279305433202)
DISCORD_ROLE_DAY_PASS=""           # VIXY (24HR) Elite Role ID (e.g. 1538094678870593547)
DISCORD_ROLE_ELITE=""              # VIXY Elite Subscriber Role ID (e.g. 1535025983093215425)
DISCORD_ROLE_ADMINISTRATOR=""      # Admin Role ID

# Webhooks for Granular Discord Channel Routing (Optional — defaults to DISCORD_WEBHOOK_URL)
DISCORD_WEBHOOK_URL=""             # General Webhook URL for broadcasts
DISCORD_WEBHOOK_SIGNALS=""         # #bot-signals / #ai-signals Webhook
DISCORD_WEBHOOK_WHALE=""           # #whale-tracker Webhook
DISCORD_WEBHOOK_BREAKING=""        # #breaking-news Webhook
DISCORD_WEBHOOK_PROTECTION=""      # #vixys-protection Webhook
DISCORD_WEBHOOK_ANALYSIS=""        # #market-analysis Webhook
DISCORD_WEBHOOK_VIP=""             # #premium-signals Webhook
DISCORD_WEBHOOK_TERMINAL=""        # #ai-terminal Webhook
DISCORD_WEBHOOK_FLOW=""            # #flow-forge Webhook
DISCORD_WEBHOOK_ANALYTICS=""       # #analytics Webhook
DISCORD_WEBHOOK_LOGS=""            # #audit-logs / #bot-logs / #error-logs Webhook

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENTS & VIP CHECKOUT (Optional)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

STRIPE_DAY_PASS_PRICE_ID=""        # VIXY Vault 24H Day Pass ($9.99 USD One-Time)
STRIPE_STARTER_MONTHLY_PRICE_ID=""
STRIPE_STARTER_ANNUAL_PRICE_ID=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_ANNUAL_PRICE_ID=""
STRIPE_ELITE_MONTHLY_PRICE_ID=""
STRIPE_ELITE_ANNUAL_PRICE_ID=""

# ------------------------------------------------------------------------------
# 4. AI MODEL PROVIDERS (Optional — model fallback active if empty)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. KALSHI PRODUCTION MARKET DATA
# ------------------------------------------------------------------------------
KALSHI_API_KEY_ID=""               # Kalshi API Key ID / Access Key
KALSHI_PRIVATE_KEY=""               # Kalshi RSA Private Key (PEM format or base64)
KALSHI_ENVIRONMENT="production"     # "production" or "demo"
KALSHI_BASE_URL="https://external-api.kalshi.com/trade-api/v2"

# ------------------------------------------------------------------------------
# 6. SECURITY & PERSISTENCE
# ------------------------------------------------------------------------------
JWT_SECRET="vixy-ai-super-secret-jwt-key-32chars"
ENCRYPTION_KEY="vixy-ai-aes-256-encryption-key-passphrase"
FIREBASE_PROJECT_ID="ai-studio-btc15pro15minbtc-5ffd95f2-2d75-456b-8811-6d9cbc0c1c72"
